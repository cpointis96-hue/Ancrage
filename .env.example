# Exemple non secret de configuration locale.
# Copier ce fichier vers .env.local puis renseigner les valeurs localement.
# .env.local est ignoré par Git et ne doit jamais être committé.

# Token Cloudflare personnalisé à permissions minimales.
# Ne jamais mettre une vraie clé ici.
CLOUDFLARE_API_TOKEN="ton API ici"

# Identifiant public du compte Cloudflare, facultatif tant qu'il n'est pas requis.
CLOUDFLARE_ACCOUNT_ID=""

# Clé API Neon : ne jamais mettre une vraie clé dans ce fichier.
NEON_API_KEY="ton API Neon ici"

# Identifiant du projet Neon, non secret.
NEON_PROJECT_ID=""

# URL de connexion PostgreSQL : ne jamais la committer.
NEON_DATABASE_URL=""

# Nom d'utilisateur Name.com si la clé enregistrée n'est pas un JSON
# {"username":"...","token":"..."}.
NAMECOM_USERNAME=""

# Base API Name.com. L'URL de production est utilisée par défaut.
NAMECOM_API_BASE_URL="https://api.name.com/core/v1"
