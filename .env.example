# Variables consommées par le runtime. Exporter ces valeurs avant npm run dev.
# .env.local est privé et n’est pas chargé automatiquement.
PORT=4173
ANCRAGE_DATA_DIR=.ancrage

# Compléments facultatifs aux secrets enregistrés depuis le cockpit.
CLOUDFLARE_ACCOUNT_ID=
NAMECOM_USERNAME=
NAMECOM_API_BASE_URL=https://api.name.com/core/v1
