{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "demo-readiness",
  "type": "object",
  "required": ["templateFamily", "status", "checks", "missing", "blocks"],
  "properties": {
    "templateFamily": { "type": "string", "minLength": 1, "maxLength": 80 },
    "status": { "type": "string", "enum": ["READY", "INCOMPLETE", "BLOCKED"] },
    "checks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": {
        "type": "object",
        "required": ["id", "status"],
        "properties": {
          "id": { "type": "string", "minLength": 1, "maxLength": 120 },
          "status": { "type": "string", "enum": ["PASS", "WARN", "BLOCK"] }
        },
        "additionalProperties": false
      }
    },
    "missing": { "type": "array", "maxItems": 50, "items": { "type": "string", "minLength": 1, "maxLength": 300 } },
    "blocks": { "type": "array", "maxItems": 50, "items": { "type": "string", "minLength": 1, "maxLength": 300 } }
  },
  "additionalProperties": false
}
