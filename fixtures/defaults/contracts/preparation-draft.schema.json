{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "preparation-draft",
  "type": "object",
  "required": ["id", "auditPacketRef", "revision", "locale", "values"],
  "properties": {
    "id": { "type": "string", "minLength": 1, "maxLength": 120 },
    "auditPacketRef": { "type": "string", "minLength": 1, "maxLength": 300 },
    "revision": { "type": "integer", "minimum": 1 },
    "locale": { "type": "string", "pattern": "^[a-z]{2}-[A-Z]{2}$" },
    "values": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "required": ["field", "value", "source", "confirmation"],
        "properties": {
          "field": { "type": "string", "minLength": 1, "maxLength": 80 },
          "value": {},
          "source": { "type": "string", "minLength": 1, "maxLength": 80 },
          "confirmation": { "type": "string", "enum": ["REQUIRED", "CONFIRMED", "REJECTED"] }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
