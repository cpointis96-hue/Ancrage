{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "site-spec",
  "type": "object",
  "required": ["schemaVersion", "title", "locale", "provenance", "confirmation", "template", "pages", "assets"],
  "properties": {
    "schemaVersion": { "type": "string", "enum": ["site-spec-v1"] },
    "title": { "type": "string", "minLength": 1, "maxLength": 160 },
    "locale": { "type": "string", "pattern": "^[a-z]{2}-[A-Z]{2}$" },
    "provenance": { "type": "object", "required": ["auditPacketRef", "preparationDraftRef"], "properties": { "auditPacketRef": { "type": "string", "minLength": 1, "maxLength": 300 }, "preparationDraftRef": { "type": "string", "minLength": 1, "maxLength": 300 } }, "additionalProperties": false },
    "confirmation": { "type": "object", "required": ["status", "confirmedAt"], "properties": { "status": { "type": "string", "enum": ["CONFIRMED"] }, "confirmedAt": { "type": "string", "minLength": 1, "maxLength": 40 } }, "additionalProperties": false },
    "template": { "type": "object", "required": ["id", "versionId", "hash"], "properties": { "id": { "type": "string", "minLength": 1, "maxLength": 120 }, "versionId": { "type": "string", "minLength": 1, "maxLength": 120 }, "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" } }, "additionalProperties": false },
    "pages": { "type": "array", "minItems": 1, "maxItems": 10, "items": { "type": "object", "required": ["path", "title", "sections", "provenanceRefs", "confirmation"], "properties": { "path": { "type": "string", "pattern": "^/" }, "title": { "type": "string", "minLength": 1, "maxLength": 160 }, "sections": { "type": "array", "minItems": 1, "maxItems": 20, "items": { "type": "string", "minLength": 1, "maxLength": 80 } }, "provenanceRefs": { "type": "array", "minItems": 1, "maxItems": 100, "items": { "type": "string", "minLength": 1, "maxLength": 300 } }, "confirmation": { "type": "string", "enum": ["CONFIRMED"] } }, "additionalProperties": false } },
    "assets": { "type": "array", "maxItems": 100, "items": { "type": "object", "required": ["id", "artifactRef", "rightsStatus", "provenanceRefs", "confirmation"], "properties": { "id": { "type": "string", "minLength": 1, "maxLength": 120 }, "artifactRef": { "type": "string", "minLength": 1, "maxLength": 300 }, "rightsStatus": { "type": "string", "enum": ["OWNED", "AUTHORIZED", "LICENSED"] }, "provenanceRefs": { "type": "array", "minItems": 1, "maxItems": 50, "items": { "type": "string", "minLength": 1, "maxLength": 300 } }, "confirmation": { "type": "string", "enum": ["CONFIRMED"] } }, "additionalProperties": false } }
  },
  "additionalProperties": false
}
