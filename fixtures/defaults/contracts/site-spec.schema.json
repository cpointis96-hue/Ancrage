{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "site-spec",
  "type": "object",
  "required": ["schemaVersion", "title", "locale", "template", "pages", "assets"],
  "properties": {
    "schemaVersion": { "type": "string", "enum": ["site-spec-v1"] },
    "title": { "type": "string", "minLength": 1, "maxLength": 160 },
    "locale": { "type": "string", "pattern": "^[a-z]{2}-[A-Z]{2}$" },
    "template": {
      "type": "object",
      "required": ["id", "versionId", "hash"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 120 },
        "versionId": { "type": "string", "minLength": 1, "maxLength": 120 },
        "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      },
      "additionalProperties": false
    },
    "pages": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "items": {
        "type": "object",
        "required": ["path", "title", "sections"],
        "properties": {
          "path": { "type": "string", "pattern": "^/" },
          "title": { "type": "string", "minLength": 1, "maxLength": 160 },
          "sections": { "type": "array", "minItems": 1, "maxItems": 20, "items": { "type": "string", "minLength": 1, "maxLength": 80 } }
        },
        "additionalProperties": false
      }
    },
    "assets": { "type": "array", "maxItems": 100, "items": { "type": "object" } }
  },
  "additionalProperties": false
}
