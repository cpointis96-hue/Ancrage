{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "seo-research-plan",
  "type": "object",
  "required": ["category", "queries"],
  "properties": {
    "category": { "type": "string" },
    "queries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["query", "intent", "basis"],
        "properties": {
          "query": { "type": "string" },
          "intent": { "type": "string", "enum": ["brand", "discovery", "menu", "reservation"] },
          "basis": { "type": "string", "enum": ["business-name", "observed-category", "observed-content"] },
          "targetPage": { "type": "string", "enum": ["page-accueil", "page-menu", "page-reservation", "page-services", "page-contact"] },
          "reason": { "type": "string", "maxLength": 400 },
          "sourceUrl": { "type": "string", "maxLength": 2048 },
          "quote": { "type": "string", "maxLength": 250 }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
