{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "audit-packet",
  "type": "object",
  "required": ["schemaVersion", "packetId", "revision", "auditRunId", "createdAt", "status", "subject", "values", "coverage", "evidenceRefs", "findings", "market", "deterministicRecommendations", "aiContributions", "limitations", "cost", "lineage", "artifacts", "preparationDraft"],
  "properties": {
    "schemaVersion": { "type": "string", "enum": ["audit-packet-v1"] },
    "packetId": { "type": "string", "minLength": 1, "maxLength": 120 },
    "revision": { "type": "integer", "minimum": 1 },
    "auditRunId": { "type": "string", "minLength": 1, "maxLength": 120 },
    "createdAt": { "type": "string", "minLength": 1, "maxLength": 40 },
    "status": { "type": "string", "enum": ["SUCCEEDED", "PARTIAL", "BLOCKED"] },
    "subject": { "$ref": "#/$defs/subject" },
    "values": { "type": "object", "required": ["address", "category", "website"], "properties": { "address": { "$ref": "#/$defs/classifiedValue" }, "category": { "$ref": "#/$defs/classifiedValue" }, "website": { "$ref": "#/$defs/classifiedValue" } } },
    "coverage": { "type": "object", "required": ["establishment", "localPresence", "siteAudit", "market"], "properties": { "establishment": { "$ref": "#/$defs/coverage" }, "localPresence": { "$ref": "#/$defs/coverage" }, "siteAudit": { "$ref": "#/$defs/coverage" }, "market": { "$ref": "#/$defs/coverage" } }, "additionalProperties": false },
    "evidenceRefs": { "type": "array", "maxItems": 200, "items": { "type": "string", "minLength": 1, "maxLength": 300 } },
    "findings": { "type": "array", "maxItems": 200, "items": { "type": "object" } },
    "market": { "$ref": "#/$defs/market" },
    "deterministicRecommendations": { "type": "array", "maxItems": 100, "items": { "$ref": "#/$defs/recommendation" } },
    "aiContributions": { "type": "array", "maxItems": 50, "items": { "$ref": "#/$defs/aiContribution" } },
    "limitations": { "type": "array", "maxItems": 100, "items": { "type": "string", "minLength": 1, "maxLength": 1000 } },
    "cost": { "$ref": "#/$defs/cost" },
    "lineage": { "$ref": "#/$defs/lineage" },
    "artifacts": { "$ref": "#/$defs/artifacts" },
    "preparationDraft": { "$ref": "#/$defs/preparationDraft" }
  },
  "$defs": {
    "subject": { "type": "object", "required": ["request", "resolution"], "properties": { "request": { "type": "object", "required": ["name", "city"], "properties": { "name": { "type": "string", "minLength": 1, "maxLength": 160 }, "city": { "type": "object", "required": ["id", "label", "countryCode"], "properties": { "id": { "type": "string", "minLength": 1, "maxLength": 120 }, "label": { "type": "string", "minLength": 1, "maxLength": 160 }, "countryCode": { "type": "string", "pattern": "^[A-Z]{2}$" } }, "additionalProperties": false } }, "additionalProperties": false }, "resolution": { "type": "object", "required": ["decision", "establishmentStatus", "siteStatus", "selectedEstablishmentEvidenceRefs"], "properties": { "decision": { "type": "string", "minLength": 1, "maxLength": 80 }, "establishmentStatus": { "type": "string", "minLength": 1, "maxLength": 80 }, "siteStatus": { "type": "string", "minLength": 1, "maxLength": 80 }, "selectedEstablishmentEvidenceRefs": { "type": "array", "maxItems": 50, "items": { "type": "string", "minLength": 1, "maxLength": 300 } } }, "additionalProperties": false } }, "additionalProperties": false },
    "classifiedValue": { "type": "object", "required": ["state", "value", "authority", "observedAt", "evidenceRefs"], "properties": { "state": { "type": "string", "enum": ["OBSERVED", "CALCULATED", "AI_INTERPRETED", "SUGGESTED", "HYPOTHESIS", "CONFLICT", "UNKNOWN", "MISSING"] }, "value": {}, "authority": { "type": "string", "minLength": 1, "maxLength": 120 }, "observedAt": { "type": ["string", "null"], "maxLength": 40 }, "evidenceRefs": { "type": "array", "maxItems": 50, "items": { "type": "string", "minLength": 1, "maxLength": 300 } } }, "additionalProperties": false },
    "coverage": { "type": "object", "required": ["status", "coverage", "cause"], "properties": { "status": { "type": "string", "enum": ["SUCCEEDED", "PARTIAL", "BLOCKED", "NOT_RUN"] }, "coverage": { "type": "string", "enum": ["FULL", "PARTIAL", "UNAVAILABLE"] }, "cause": { "type": "string", "minLength": 1, "maxLength": 300 } }, "additionalProperties": false },
    "market": { "type": "object", "required": ["searchMarket", "competitorCandidates", "selectedCompetitors", "keywordOpportunities"], "properties": { "searchMarket": { "type": "object", "required": ["engine", "countryCode", "languageCode", "location", "device"], "properties": { "engine": { "type": "string", "minLength": 1, "maxLength": 40 }, "countryCode": { "type": "string", "pattern": "^[A-Z]{2}$" }, "languageCode": { "type": "string", "pattern": "^[a-z]{2}$" }, "location": { "type": "string", "minLength": 1, "maxLength": 160 }, "device": { "type": "string", "enum": ["desktop", "mobile"] } }, "additionalProperties": false }, "competitorCandidates": { "type": "array", "maxItems": 20, "items": { "type": "object" } }, "selectedCompetitors": { "type": "array", "maxItems": 5, "items": { "type": "object" } }, "keywordOpportunities": { "type": "array", "maxItems": 50, "items": { "type": "object" } } }, "additionalProperties": false },
    "recommendation": { "type": "object", "required": ["code", "text", "findingRefs"], "properties": { "code": { "type": "string", "minLength": 1, "maxLength": 120 }, "text": { "type": "string", "minLength": 1, "maxLength": 2000 }, "findingRefs": { "type": "array", "maxItems": 50, "items": { "type": "string", "minLength": 1, "maxLength": 300 } } }, "additionalProperties": false },
    "aiContribution": { "type": "object", "required": ["purpose", "status", "cause", "executionRef", "provenanceRefs", "costEventRefs", "recommendations"], "properties": { "purpose": { "type": "string", "minLength": 1, "maxLength": 120 }, "status": { "type": "string", "enum": ["NOT_RUN", "SUCCEEDED", "PARTIAL", "BLOCKED", "FAILED"] }, "cause": { "type": ["string", "null"], "maxLength": 300 }, "executionRef": { "type": ["string", "null"], "maxLength": 300 }, "provenanceRefs": { "type": "array", "maxItems": 20, "items": { "type": "string", "minLength": 1, "maxLength": 300 } }, "costEventRefs": { "type": "array", "maxItems": 20, "items": { "type": "string", "minLength": 1, "maxLength": 300 } }, "recommendations": { "type": "array", "maxItems": 100, "items": { "type": "object" } } }, "additionalProperties": false },
    "cost": { "type": "object", "required": ["currency", "hardLimit", "spent", "reserved", "costEventsRef"], "properties": { "currency": { "type": "string", "enum": ["USD"] }, "hardLimit": { "type": "number", "minimum": 0, "maximum": 0.5 }, "spent": { "type": "number", "minimum": 0, "maximum": 0.5 }, "reserved": { "type": "number", "minimum": 0, "maximum": 0.5 }, "costEventsRef": { "type": "string", "minLength": 1, "maxLength": 300 } }, "sumMaximum": { "properties": ["spent", "reserved"], "maximumProperty": "hardLimit" }, "additionalProperties": false },
    "lineage": { "type": "object", "required": ["workflowVersion", "packetContractVersion", "promptVersions", "ruleVersions"], "properties": { "workflowVersion": { "type": "string", "minLength": 1, "maxLength": 120 }, "packetContractVersion": { "type": "string", "minLength": 1, "maxLength": 120 }, "promptVersions": { "type": "array", "maxItems": 100, "items": { "type": "string", "minLength": 1, "maxLength": 120 } }, "ruleVersions": { "type": "array", "minItems": 1, "maxItems": 100, "items": { "type": "string", "minLength": 1, "maxLength": 120 } } }, "additionalProperties": false },
    "artifact": { "type": ["object", "null"], "required": ["kind", "artifactRef"], "properties": { "kind": { "type": "string", "minLength": 1, "maxLength": 40 }, "artifactRef": { "type": "string", "minLength": 1, "maxLength": 300 } }, "additionalProperties": false },
    "artifacts": { "type": "object", "required": ["gmbReport", "finalReport", "pdf"], "properties": { "gmbReport": { "$ref": "#/$defs/artifact" }, "finalReport": { "$ref": "#/$defs/artifact" }, "pdf": { "$ref": "#/$defs/artifact" } }, "additionalProperties": false },
    "preparationValue": { "type": "object", "required": ["value", "source", "confirmation"], "properties": { "value": { "type": ["string", "null"], "maxLength": 4000 }, "source": { "type": "string", "minLength": 1, "maxLength": 80 }, "confirmation": { "type": "string", "enum": ["REQUIRED", "CONFIRMED", "REJECTED"] } }, "additionalProperties": false },
    "preparationDraft": { "type": "object", "required": ["name", "address", "contact", "hours", "menu", "photos"], "properties": { "name": { "$ref": "#/$defs/preparationValue" }, "address": { "$ref": "#/$defs/preparationValue" }, "contact": { "$ref": "#/$defs/preparationValue" }, "hours": { "$ref": "#/$defs/preparationValue" }, "menu": { "type": "object", "required": ["items", "source", "confirmation"], "properties": { "items": { "type": "array", "maxItems": 100, "items": { "type": "object" } }, "source": { "type": "string", "minLength": 1, "maxLength": 80 }, "confirmation": { "type": "string", "enum": ["REQUIRED", "CONFIRMED", "REJECTED"] } }, "additionalProperties": false }, "photos": { "type": "array", "maxItems": 100, "items": { "type": "object" } } }, "additionalProperties": false }
  },
  "additionalProperties": false
}
