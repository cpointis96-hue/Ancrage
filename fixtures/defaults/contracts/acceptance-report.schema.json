{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "acceptance-report",
  "type": "object",
  "required": ["schemaVersion", "status", "gates", "artifactRefs", "evidenceRefs", "limitations", "operatorDecision"],
  "properties": {
    "schemaVersion": { "type": "string", "enum": ["acceptance-report-v1"] },
    "status": { "type": "string", "enum": ["PASS", "WARN", "BLOCK"] },
    "gates": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "required": ["id", "status", "evidenceRefs"],
        "properties": {
          "id": { "type": "string", "minLength": 1, "maxLength": 120 },
          "status": { "type": "string", "enum": ["PASS", "WARN", "BLOCK"] },
          "evidenceRefs": { "type": "array", "maxItems": 50, "items": { "type": "string", "minLength": 1, "maxLength": 300 } }
        },
        "additionalProperties": false
      }
    },
    "artifactRefs": { "type": "array", "minItems": 1, "maxItems": 100, "items": { "type": "string", "minLength": 1, "maxLength": 300 } },
    "evidenceRefs": { "type": "array", "maxItems": 200, "items": { "type": "string", "minLength": 1, "maxLength": 300 } },
    "limitations": { "type": "array", "maxItems": 100, "items": { "type": "string", "minLength": 1, "maxLength": 1000 } },
    "operatorDecision": { "type": "string", "enum": ["PENDING", "APPROVED", "CHANGES_REQUESTED", "REJECTED"] }
  },
  "additionalProperties": false
}
