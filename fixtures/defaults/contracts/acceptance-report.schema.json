{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "acceptance-report",
  "type": "object",
  "required": ["schemaVersion", "revision", "status", "ruleVersions", "gates", "artifactRefs", "evidenceRefs", "limitations", "operatorDecision"],
  "properties": {
    "schemaVersion": { "type": "string", "enum": ["acceptance-report-v1"] },
    "revision": { "type": "integer", "minimum": 1 },
    "status": { "type": "string", "enum": ["PASS", "WARN", "BLOCK"] },
    "ruleVersions": { "type": "array", "minItems": 1, "maxItems": 100, "items": { "type": "string", "minLength": 1, "maxLength": 120 } },
    "gates": { "type": "array", "minItems": 1, "maxItems": 100, "items": { "type": "object", "required": ["id", "status", "ruleVersion", "checkVersion", "evidenceRefs"], "properties": { "id": { "type": "string", "minLength": 1, "maxLength": 120 }, "status": { "type": "string", "enum": ["PASS", "WARN", "BLOCK"] }, "ruleVersion": { "type": "string", "minLength": 1, "maxLength": 120 }, "checkVersion": { "type": "string", "minLength": 1, "maxLength": 120 }, "evidenceRefs": { "type": "array", "maxItems": 50, "items": { "type": "string", "minLength": 1, "maxLength": 300 } } }, "additionalProperties": false } },
    "artifactRefs": { "type": "array", "minItems": 1, "maxItems": 100, "items": { "type": "string", "minLength": 1, "maxLength": 300 } },
    "evidenceRefs": { "type": "array", "maxItems": 200, "items": { "type": "string", "minLength": 1, "maxLength": 300 } },
    "limitations": { "type": "array", "maxItems": 100, "items": { "type": "string", "minLength": 1, "maxLength": 1000 } },
    "operatorDecision": { "type": "string", "enum": ["PENDING", "APPROVED", "CHANGES_REQUESTED", "REJECTED"] }
  },
  "additionalProperties": false
}
